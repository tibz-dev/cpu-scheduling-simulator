<Window x:Class="SchedulerGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU Scheduling Simulator"
        Height="820"
        Width="1220"
        MinHeight="700"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9DEE5"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="#D9DEE5"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="CPU Scheduling Simulator"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>
                <TextBlock Text="FCFS • SRTF • Round Robin"
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#E8EEF9"
                    CornerRadius="5"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready"
                           Foreground="#244B7A"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- Configuration -->
        <GroupBox Grid.Row="1" Header="Simulation Configuration">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Process count:" VerticalAlignment="Center"/>
                <ComboBox x:Name="ProcessCountComboBox" Grid.Column="1" Margin="8,0,0,0"/>

                <TextBlock Grid.Column="3" Text="Trial:" VerticalAlignment="Center"/>
                <ComboBox x:Name="TrialComboBox" Grid.Column="4" Margin="8,0,0,0"/>

                <TextBlock Grid.Column="6" Text="Algorithm:" VerticalAlignment="Center"/>
                <ComboBox x:Name="AlgorithmComboBox"
                          Grid.Column="7"
                          Margin="8,0,0,0"
                          SelectionChanged="AlgorithmComboBox_SelectionChanged"/>

                <TextBlock Grid.Column="9" Text="RR quantum:" VerticalAlignment="Center"/>
                <TextBox x:Name="QuantumTextBox"
                         Grid.Column="10"
                         Margin="8,0,0,0"
                         Text="4"
                         IsEnabled="False"/>
            </Grid>
        </GroupBox>

        <!-- Tables -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Generated Workload">
                <DataGrid x:Name="WorkloadDataGrid" ItemsSource="{Binding Workload}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="*"/>
                        <DataGridTextColumn Header="Arrival" Binding="{Binding ArrivalTime}" Width="*"/>
                        <DataGridTextColumn Header="Burst" Binding="{Binding BurstTime}" Width="*"/>
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Simulation Results">
                <DataGrid x:Name="ResultsDataGrid" ItemsSource="{Binding Results}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="0.75*"/>
                        <DataGridTextColumn Header="Start" Binding="{Binding FirstStartTime}" Width="*"/>
                        <DataGridTextColumn Header="Complete" Binding="{Binding CompletionTime}" Width="*"/>
                        <DataGridTextColumn Header="Waiting" Binding="{Binding WaitingTime}" Width="*"/>
                        <DataGridTextColumn Header="Turnaround" Binding="{Binding TurnaroundTime}" Width="1.1*"/>
                        <DataGridTextColumn Header="Response" Binding="{Binding ResponseTime}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- Metrics -->
        <GroupBox Grid.Row="3" Header="Performance Summary">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="8">
                    <TextBlock Text="Average Waiting Time" Foreground="#6B7280"/>
                    <TextBlock x:Name="AverageWaitingText" Text="—" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8">
                    <TextBlock Text="Average Turnaround Time" Foreground="#6B7280"/>
                    <TextBlock x:Name="AverageTurnaroundText" Text="—" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="8">
                    <TextBlock Text="Average Response Time" Foreground="#6B7280"/>
                    <TextBlock x:Name="AverageResponseText" Text="—" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="8">
                    <TextBlock Text="Seed" Foreground="#6B7280"/>
                    <TextBlock x:Name="SeedText" Text="—" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Timeline -->
        <GroupBox Grid.Row="4" Header="Execution Timeline">
            <DataGrid x:Name="TimelineDataGrid" ItemsSource="{Binding Timeline}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="*"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartTime}" Width="*"/>
                    <DataGridTextColumn Header="End" Binding="{Binding EndTime}" Width="*"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationTextBlock"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#B42318"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="GenerateButton"
                        Content="Generate Workload"
                        Click="GenerateButton_Click"/>
                <Button x:Name="RunButton"
                        Content="Run Simulation"
                        Click="RunButton_Click"/>
                <Button x:Name="ResetButton"
                        Content="Reset"
                        Click="ResetButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>